# Meson cross file for Android x86_64 (x86_64)
# Generated from template by build_android.sh — do not edit the generated copy.
# @ANDROID_NDK@ is substituted with the ANDROID_NDK environment variable.

[binaries]
c = '@ANDROID_NDK@/toolchains/llvm/prebuilt/@ANDROID_NDK_HOST@/bin/x86_64-linux-android29-clang@ANDROID_CLANG_SUFFIX@'
cpp = '@ANDROID_NDK@/toolchains/llvm/prebuilt/@ANDROID_NDK_HOST@/bin/x86_64-linux-android29-clang++@ANDROID_CLANG_SUFFIX@'
ar = '@ANDROID_NDK@/toolchains/llvm/prebuilt/@ANDROID_NDK_HOST@/bin/llvm-ar@ANDROID_EXE_SUFFIX@'
strip = '@ANDROID_NDK@/toolchains/llvm/prebuilt/@ANDROID_NDK_HOST@/bin/llvm-strip@ANDROID_EXE_SUFFIX@'

[built-in options]
c_args = ['-O3', '-ffast-math']
cpp_args = ['-O3', '-ffast-math', '-frtti', '-fexceptions']
c_link_args = ['-fexceptions', '-fopenmp', '-static-openmp']
cpp_link_args = ['-fexceptions', '-fopenmp', '-static-openmp']

[host_machine]
system = 'android'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
